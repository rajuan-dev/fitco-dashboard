# Backend API base URL (optional)
# If omitted, frontend uses local mock data.
VITE_API_BASE_URL=http://localhost:5000

# Request timeout for all API calls (milliseconds)
VITE_API_TIMEOUT_MS=15000

# Keep false in production.
# true = if API request fails, fallback to mock response.
VITE_API_USE_MOCKS_ON_ERROR=false
